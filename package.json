{
  "name": "sales-sim-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next node_modules && npm i",
    "dev": "cross-env PORT=3000 next dev -p 3000",
    "dev:kill": "node -e \"require('child_process').exec('lsof -ti tcp:3000,3001 | xargs -r kill -9',()=>process.exit(0))\"",
    "dev:clean": "rm -rf .next node_modules/.cache .turbo 2>/dev/null || true",
    "dev:reset": "npm run dev:kill && npm run dev:clean && npm run dev",
    "health": "node scripts/health-check.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
